# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://nnm_app:changeme@localhost:5432/nnm_property_tax
PGPOOL_MAX=10

# CORS — comma-separated list of allowed origins (your Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Auth — generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=1y

# Document verification QR codes — signs the public /verify/... links.
# Generate the same way as JWT_zSECRET, but keep it a separate value.
VERIFICATION_SECRET=replace-this-with-a-different-long-random-string

# Online payment gateway (ICICI)
FRONTEND_URL=http://localhost:3000
ICICI_MERCHANT_ID=100000000445282

# Email (password reset) — Gmail SMTP. SMTP_USER/SMTP_PASSWORD are
# required; the server will not start without them. SMTP_PASSWORD must
# be a Gmail App Password (not the account's normal login password) —
# see Google Account > Security > 2-Step Verification > App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-the-sending-gmail-address
SMTP_PASSWORD=replace-with-a-gmail-app-password

# Attendance module - daily group photo storage. Defaults to a local
# folder if unset. On the SDC servers, point this at the NFS mount
# (e.g. /image-upload) so photos survive an App server redeploy.
PHOTO_UPLOAD_DIR=./uploads/attendance-photos

# --- Used only by scripts/migrate-from-sheets.ts ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json